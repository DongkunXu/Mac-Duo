// Code signing. By default the app is signed to run locally (ad hoc), which needs no Apple account.
// macOS then links the Screen Recording permission to that exact build, and it has to be granted
// again after every rebuild. To keep it across rebuilds, sign with a certificate of your own:
// copy Signing.local.xcconfig.example to Signing.local.xcconfig (ignored by git) and fill it in.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// The hardened runtime refuses to load the embedded framework when neither has a team ID.
ENABLE_HARDENED_RUNTIME = NO

#include? "Signing.local.xcconfig"
