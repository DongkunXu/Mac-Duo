          }
        }
      }
    },
    "Extra distance added everywhere once folding starts, softening the hinge edge too. 0 keeps the hinge region sharp." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始折叠后在所有位置额外增加的距离，转轴附近也会变模糊。设为 0 时转轴附近保持清晰。"
